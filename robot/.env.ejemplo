# Plantilla de robot/.env. El .env real ya está en git (repo privado) con las claves de Supabase:
# para los otros métodos de envío, agregar las líneas que falten en ese archivo, no reemplazarlo.
# Ver reporte/envio.py y la sección 11 del plan.

# envio.metodo = carpeta: carpeta compartida con el dashboard (Drive / OneDrive sincronizado)
ENVIO_CARPETA=

# envio.metodo = api: dirección donde el dashboard recibe los archivos (POST) y su clave
ENVIO_URL=
ENVIO_TOKEN=
# opcional: dirección para revisar si hay conexión (si no, se usa ENVIO_URL)
ENVIO_PING_URL=

# envio.metodo = supabase: la app de la tablet lee el reporte de Supabase (ver subir_reporte.py)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
